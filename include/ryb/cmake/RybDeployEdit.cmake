# Purpose: read and rewrite ryb_comms.json for tools/deploy.sh, so deploying needs nothing but
# bash and the CMake the build already requires. Owning module: management (mgmt/).
#
#   cmake -DJSON=<file> -DOUT=<file> -DACTION=dump  -P RybDeployEdit.cmake
#   cmake -DJSON=<file>              -DACTION=apply -P RybDeployEdit.cmake
#
# dump writes one line per item:
#   module <name> <address> <tx or -> <repeater 0|1> <rx or ->
#   pin <name> <bit>
#   lcd <bl> <rst> <dc> <cs> <sclk> <mosi>        or   lcd none
#   line <bit_period_us> <drive> <idle_sleep_us>
# where rx is PIN=sender+sender,PIN=sender.
#
# apply rewrites one module and the shared settings from the environment: RYB_MODULE, RYB_TX
# (empty for none), RYB_RX (as above, empty for none), RYB_REPEATER (0|1), RYB_LCD (rpi, arduino,
# none or keep), RYB_BIT_PERIOD_US, RYB_DRIVE.

cmake_minimum_required(VERSION 3.19)

file(READ "${JSON}" json)

# The display wirings deploy.sh offers: RYB_Displ3 seated on the Raspberry Pi header, and
# libpynq's default on the Arduino header.
set(lcd_roles bl rst dc cs sclk mosi)
set(lcd_rpi RBPI40 RBPI38 RBPI37 RBPI36 RBPI35 RBPI33)
set(lcd_arduino AR10 AR11 AR12 AR13 AR_SCL AR_SDA)

if(ACTION STREQUAL "dump")
    set(out "")
    string(JSON modules GET "${json}" modules)
    string(JSON count LENGTH "${modules}")
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${modules}" ${i})
        string(JSON address GET "${modules}" ${name} address)
        string(JSON tx_type TYPE "${modules}" ${name} tx)
        set(tx "-")
        if(tx_type STREQUAL "STRING")
            string(JSON tx GET "${modules}" ${name} tx)
        endif()
        string(JSON repeater GET "${modules}" ${name} repeater)
        if(repeater)
            set(repeater 1)
        else()
            set(repeater 0)
        endif()
        string(JSON rx GET "${modules}" ${name} rx)
        string(JSON link_count LENGTH "${rx}")
        set(links "")
        if(link_count GREATER 0)
            math(EXPR link_last "${link_count} - 1")
            foreach(j RANGE ${link_last})
                string(JSON pin GET "${rx}" ${j} pin)
                string(JSON from GET "${rx}" ${j} from)
                string(JSON from_count LENGTH "${from}")
                set(senders "")
                if(from_count GREATER 0)
                    math(EXPR from_last "${from_count} - 1")
                    foreach(k RANGE ${from_last})
                        string(JSON sender GET "${from}" ${k})
                        list(APPEND senders ${sender})
                    endforeach()
                endif()
                list(JOIN senders "+" senders)
                list(APPEND links "${pin}=${senders}")
            endforeach()
        endif()
        if(links)
            list(JOIN links "," links)
        else()
            set(links "-")
        endif()
        string(APPEND out "module ${name} ${address} ${tx} ${repeater} ${links}\n")
    endforeach()

    string(JSON pins GET "${json}" pins)
    string(JSON count LENGTH "${pins}")
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${pins}" ${i})
        string(JSON bit GET "${pins}" ${name})
        string(APPEND out "pin ${name} ${bit}\n")
    endforeach()

    string(JSON lcd_type ERROR_VARIABLE err TYPE "${json}" lcd)
    if(err OR lcd_type STREQUAL "NULL")
        string(APPEND out "lcd none\n")
    else()
        set(lcd_pins "")
        foreach(role IN LISTS lcd_roles)
            string(JSON pin GET "${json}" lcd ${role})
            list(APPEND lcd_pins ${pin})
        endforeach()
        list(JOIN lcd_pins " " lcd_pins)
        string(APPEND out "lcd ${lcd_pins}\n")
    endif()

    string(JSON bit_period GET "${json}" line bit_period_us)
    string(JSON drive GET "${json}" line drive)
    string(JSON idle_sleep GET "${json}" line idle_sleep_us)
    string(APPEND out "line ${bit_period} ${drive} ${idle_sleep}\n")
    file(WRITE "${OUT}" "${out}")

elseif(ACTION STREQUAL "apply")
    set(m "$ENV{RYB_MODULE}")
    string(JSON ignored ERROR_VARIABLE err GET "${json}" modules ${m})
    if(err)
        message(FATAL_ERROR "ryb_comms.json has no module '${m}'")
    endif()

    if("$ENV{RYB_TX}" STREQUAL "")
        set(tx_json "null")
    else()
        set(tx_json "\"$ENV{RYB_TX}\"")
    endif()
    string(JSON json SET "${json}" modules ${m} tx "${tx_json}")

    set(rx_json "[]")
    set(rx_spec "$ENV{RYB_RX}")
    if(NOT rx_spec STREQUAL "")
        set(objects "")
        string(REPLACE "," ";" links "${rx_spec}")
        foreach(link IN LISTS links)
            if(NOT link MATCHES "^([^=]+)=(.+)$")
                message(FATAL_ERROR "bad receive link '${link}', expected PIN=sender+sender")
            endif()
            set(pin "${CMAKE_MATCH_1}")
            string(REPLACE "+" ";" senders "${CMAKE_MATCH_2}")
            set(quoted "")
            foreach(sender IN LISTS senders)
                list(APPEND quoted "\"${sender}\"")
            endforeach()
            list(JOIN quoted ", " quoted)
            list(APPEND objects "{ \"pin\": \"${pin}\", \"from\": [${quoted}] }")
        endforeach()
        list(JOIN objects ", " objects)
        set(rx_json "[${objects}]")
    endif()
    string(JSON json SET "${json}" modules ${m} rx "${rx_json}")

    if("$ENV{RYB_REPEATER}" STREQUAL "1")
        string(JSON json SET "${json}" modules ${m} repeater true)
    else()
        string(JSON json SET "${json}" modules ${m} repeater false)
    endif()

    set(lcd "$ENV{RYB_LCD}")
    if(lcd STREQUAL "none")
        string(JSON json SET "${json}" lcd null)
    elseif(lcd STREQUAL "rpi" OR lcd STREQUAL "arduino")
        set(fields "")
        foreach(role pin IN ZIP_LISTS lcd_roles lcd_${lcd})
            list(APPEND fields "\"${role}\": \"${pin}\"")
        endforeach()
        list(JOIN fields ", " fields)
        string(JSON json SET "${json}" lcd "{ ${fields} }")
    endif()

    if(NOT "$ENV{RYB_BIT_PERIOD_US}" STREQUAL "")
        string(JSON json SET "${json}" line bit_period_us "$ENV{RYB_BIT_PERIOD_US}")
    endif()
    if(NOT "$ENV{RYB_DRIVE}" STREQUAL "")
        string(JSON json SET "${json}" line drive "\"$ENV{RYB_DRIVE}\"")
    endif()

    file(WRITE "${JSON}" "${json}\n")
else()
    message(FATAL_ERROR "ACTION must be dump or apply")
endif()
