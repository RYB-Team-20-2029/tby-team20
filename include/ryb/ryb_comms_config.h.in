/* Purpose: RYB Comms config for module "@RYB_CFG_MODULE@", generated from @RYB_CFG_JSON_NAME@.
 * Owning module: management (mgmt/). Generated by CMake: edit the JSON and rebuild, not this. */

#ifndef RYB_COMMS_CONFIG_H
#define RYB_COMMS_CONFIG_H

#include <stdint.h>

#include "ryb/ryb_packet.h"

#define RYB_CFG_MODULE_NAME       "@RYB_CFG_MODULE@"
#define RYB_CFG_ADDRESS           @RYB_CFG_ADDRESS@u
#define RYB_CFG_COMMAND_ADDRESS   @RYB_CFG_COMMAND_ADDRESS@u
#define RYB_CFG_IS_COMMAND_SENDER @RYB_CFG_IS_COMMAND_SENDER@
#define RYB_CFG_REPEATER          @RYB_CFG_REPEATER@

#define RYB_CFG_GPIO_BASE           @RYB_CFG_GPIO_BASE@u
#define RYB_CFG_DIRECTION_SETTLE_US @RYB_CFG_DIRECTION_SETTLE_US@u
#define RYB_CFG_BIT_PERIOD_US       @RYB_CFG_BIT_PERIOD_US@u
#define RYB_CFG_IDLE_SLEEP_US       @RYB_CFG_IDLE_SLEEP_US@u
#define RYB_CFG_OPEN_DRAIN          @RYB_CFG_OPEN_DRAIN@

#define RYB_CFG_THREAD_REALTIME @RYB_CFG_THREAD_REALTIME@
#define RYB_CFG_THREAD_PRIORITY @RYB_CFG_THREAD_PRIORITY@
#define RYB_CFG_THREAD_CPU      @RYB_CFG_THREAD_CPU@

/* Transmit pin as a GPIO bit, or -1 when this module has no outgoing link. */
#define RYB_CFG_TX_BIT @RYB_CFG_TX_BIT@

/* Receive links as { GPIO bit, mask of sender addresses expected on that link }. */
#define RYB_CFG_RX_LINK_COUNT @RYB_CFG_RX_LINK_COUNT@
#define RYB_CFG_RX_LINKS      @RYB_CFG_RX_LINKS@
#define RYB_CFG_ACCEPT_MASK   @RYB_CFG_ACCEPT_MASK@u

/* LCD wiring as io_switch / GPIO pin numbers. RYB_CFG_HAS_LCD is 0 when ryb_comms.json has no
 * "lcd" section. */
#define RYB_CFG_HAS_LCD  @RYB_CFG_HAS_LCD@
#define RYB_CFG_LCD_BL   @RYB_CFG_LCD_BL@u
#define RYB_CFG_LCD_RST  @RYB_CFG_LCD_RST@u
#define RYB_CFG_LCD_DC   @RYB_CFG_LCD_DC@u
#define RYB_CFG_LCD_CS   @RYB_CFG_LCD_CS@u
#define RYB_CFG_LCD_SCLK @RYB_CFG_LCD_SCLK@u
#define RYB_CFG_LCD_MOSI @RYB_CFG_LCD_MOSI@u

/* Defaults for <module>_monitor, from the optional "monitor" section. */
#define RYB_CFG_MONITOR_PERIOD_MS @RYB_CFG_MONITOR_PERIOD_MS@u
#define RYB_CFG_MONITOR_RANDOM    @RYB_CFG_MONITOR_RANDOM@

/* This module's pins by their ryb_comms.json names, for the LCD and logs. */
#define RYB_CFG_TX_NAME  "@RYB_CFG_TX_NAME@"
#define RYB_CFG_RX_NAMES "@RYB_CFG_RX_NAMES@"

/* Every pin in ryb_comms.json as { name, GPIO bit }. */
#define RYB_CFG_PIN_COUNT @RYB_CFG_PIN_COUNT@
#define RYB_CFG_PINS      @RYB_CFG_PINS@

/* Per sender address: the module's name, and what its appended packets' data field holds. */
#define RYB_CFG_SENDER_NAMES @RYB_CFG_SENDER_NAMES@
#define RYB_CFG_VALUE_NAMES  @RYB_CFG_VALUE_NAMES@

/* Receive callbacks. Each function declared here must be defined by this module, in
 * modules/@RYB_CFG_MODULE@/src/main.c; a missing one is a link error. ryb_comms_poll() calls
 * it once per valid packet from that sender. RYB_CFG_DELIVER_<address> is the call site, and
 * RYB_CFG_CALLBACK_<address> the function's name, for code that serves any module. */
@RYB_CFG_CALLBACKS@
#endif /* RYB_COMMS_CONFIG_H */
