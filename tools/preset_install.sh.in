#!/usr/bin/env bash
# Purpose: install RYB Comms on this PYNQ as the @MODULE@ module, with the preset in this archive.
# Owning module: management (mgmt/). Generated by tools/make_preset_zips.ps1.
#
# Unzip ryb_@MODULE@.zip in the home directory, so this script and tby-team20/ sit side by
# side, then run:  bash install_@MODULE@.sh
set -euo pipefail

cd "$(dirname "$0")"
if [ ! -f tby-team20/tools/deploy.sh ]; then
    echo "error: tby-team20/ is not next to this script; unzip the whole archive here first" >&2
    exit 1
fi

pins() {
    cat << 'EOF'
  module:  @MODULE@
  TX pin:  @TX@
  RX pin:  @RX@
EOF
}

echo "Installing RYB Comms as @MODULE@ with these pins:"
pins
echo

# With no network the board's clock is years behind, so files from the archive look like they
# come from the future, which confuses make. Give them the board's time.
find tby-team20 -exec touch {} +
chmod +x tby-team20/tools/*.sh

tby-team20/tools/deploy.sh @MODULE@ --quick

echo
echo "RYB Comms is running as @MODULE@ and starts at every boot."
pins
cat << 'EOF'
Wire GND between neighbouring boards as well.

Watch it:  journalctl -u ryb-comms -f     The LCD's bottom row shows the same pins.
EOF
